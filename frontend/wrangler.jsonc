{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "library-management-system-frontend",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "routes": [
